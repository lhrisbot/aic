# 依赖与构建产物
node_modules/
dist/
dist-ssr/
*.local

# 验证与临时产物（渲染验证脚本生成的截图、DOM 快照等）
.verify/
*.tmpdir/
*.tmp

# 日志
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# 编辑器 / 系统
.vscode/*
!.vscode/extensions.json
.idea/
.DS_Store
Thumbs.db
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# TypeScript 增量缓存
*.tsbuildinfo

# Python（后端队友的虚拟环境与缓存，避免误提交）
__pycache__/
*.py[cod]
.venv/
venv/
.env.local
